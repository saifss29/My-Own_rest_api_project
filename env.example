# Flask environment
# Use "development" locally and "production" when deployed.
FLASK_ENV=development

# Flask secret key
# Replace with a long, random value in your real .env file.
SECRET_KEY=replace-with-a-random-secret-key

# JWT signing key used by Flask-JWT-Extended
# Replace with a separate long, random value.
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-key

# Redis connection used by RQ for background email jobs.
# Local Redis example:
REDIS_URL=redis://localhost:6379

# Mailgun credentials used for registration emails.
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_API_KEY=your-mailgun-api-key